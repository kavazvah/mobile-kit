#!/bin/sh
# Fake adb for tests. Logs every call to $MK_SHIM_STATE/calls.log and returns canned output.
# Display overrides (wm size/density) are kept in $MK_SHIM_STATE so reads reflect writes.
S="${MK_SHIM_STATE:-/tmp/mk-shim}"
mkdir -p "$S"
echo "adb $*" >> "$S/calls.log"
if [ "$1" = "-s" ]; then shift 2; fi
case "$*" in
  "devices") printf 'List of devices attached\nemulator-5554\tdevice\n' ;;
  "version") echo "Android Debug Bridge version 1.0.41" ;;
  "shell wm size") echo "Physical size: 1080x2400"; [ -f "$S/size" ] && echo "Override size: $(cat "$S/size")" ;;
  "shell wm size reset") rm -f "$S/size" ;;
  "shell wm size "*) echo "$4" > "$S/size" ;;
  "shell wm density") echo "Physical density: 420"; [ -f "$S/density" ] && echo "Override density: $(cat "$S/density")" ;;
  "shell wm density reset") rm -f "$S/density" ;;
  "shell wm density "*) echo "$4" > "$S/density" ;;
  "exec-out screencap -p") printf 'PNG-FAKE' ;;
  "exec-out uiautomator dump /dev/tty")
    if [ -n "$MK_SHIM_UIDUMP" ]; then cat "$MK_SHIM_UIDUMP"; else echo '<?xml version="1.0"?><hierarchy rotation="0"></hierarchy>'; fi ;;
  "shell pidof -s "*) echo 4242 ;;
  "logcat "*) echo "10-01 12:00:00.000  4242  4242 I ReactNativeJS: hello" ;;
  "emu avd name") printf 'Pixel_9\nOK\n' ;;
  "shell getprop sys.boot_completed") echo 1 ;;
  *) : ;;
esac
exit "${MK_SHIM_ADB_EXIT:-0}"
